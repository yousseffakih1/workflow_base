<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="demo_reject_wizard_view_form" model="ir.ui.view">
            <field name="name">demo.reject.wizard.form</field>
            <field name="model">demo.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Request">
                    <group>
                        <field name="demo_request_id" invisible="1"/>
                        <field name="rejection_reason" placeholder="Enter the reason for rejection..."/>
                    </group>
                    <footer>
                        <button name="action_reject" string="Reject" type="object" class="btn-danger"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
