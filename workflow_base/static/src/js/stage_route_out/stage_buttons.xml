<templates>
    <span t-name="workflow_base.stage_buttons" class="stage_route_out_span_wrapper">
         <t t-foreach="state.value_json.routes" t-as="route" t-key="route.id">
             <!--                        btn-{{ route.btn_style == 'default' ? 'primary' : route.btn_style }}-->

               <button
                    t-attf-class="btn {{ route.btn_class }}"
                    t-on-click.prevent="() => this._onButtonClick(route.id)">
                <t t-esc="route.name"/>
            </button>
        </t>
    </span>
</templates>
