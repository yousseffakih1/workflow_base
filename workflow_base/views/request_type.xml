<odoo>
    <data>
        <record id="request_type_form_view" model="ir.ui.view">
            <field name="name">request.type.form</field>
            <field name="model">request.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="route_ids" invisible="1"/>
                            <field name="stage_ids" invisible="1"/>
                        </group>
                        <notebook>
                            <page string="Workflow Designer">
                                <field name="workflow_graph" widget="workflow_graph"/>
                            </page>
                            <page string="Stages">
                                <field name="stage_ids">
                                    <list  >
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="visible"/>
                                        <field name="is_draft"/>
                                        <field name="is_done"/>
                                        <field name="color"/>
                                        <field name="active" widget="boolean_toggle" />
                                        <field name="type_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Routes">
                                <field name="route_ids">
                                    <list  >
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="stage_from_id"/>
                                        <field name="stage_to_id"/>
                                        <field name="description"/>
                                        <field name="type_id" column_invisible="1"/>
                                        <field name="action_id"/>
                                        <field name="btn_class"/>
                                        <field name="allowed_group_ids" widget="many2many_tags"/>
                                        <field name="allowed_user_ids" widget="many2many_tags"/>
                                        <field name="condition_invisible"/>
                                        <field name="active" widget="boolean_toggle" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="request_type_action_window">
            <field name="name">Request Types</field>
            <field name="res_model">request.type</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>