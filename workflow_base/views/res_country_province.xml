<odoo>
    <data>
        <record model="ir.ui.view" id="res_country_province_list">
            <field name="name">res.country.province.tree</field>
            <field name="model">res.country.province</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                     <field name="name"/>
                     <field name="state_id" domain="[('country_id.code','=','MA')]"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="res_country_province_action_window">
            <field name="name">Provinces</field>
            <field name="res_model">res.country.province</field>
            <field name="view_mode">list</field>
        </record>


        <!--<menuitem name="Provinces" id="res_country_province_menu"
                  parent="patrimoine_imm_configuration_menu"  action="res_country_province_action_window"/>-->
    </data>
</odoo>
