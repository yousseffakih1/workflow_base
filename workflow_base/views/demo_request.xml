<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sequence for Demo Request -->
        <record id="seq_demo_request" model="ir.sequence">
            <field name="name">Demo Request Sequence</field>
            <field name="code">demo.request</field>
            <field name="prefix">DEMO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Form View -->
        <record id="demo_request_view_form" model="ir.ui.view">
            <field name="name">demo.request.form</field>
            <field name="model">demo.request</field>
            <field name="arch" type="xml">
                <form string="Demo Request">
                    <header>
                        <field name="stage_route_out_json" widget="stage_route_out_widget" nolabel="1"/>
                        <field name="stage_id" widget="statusbar" options="{'clickable': '0'}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box"/>
                        <div class="oe_title">
                            <h1>
                                <field name="reference" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="name" readonly="can_readonly"/>
                                <field name="user_id" readonly="can_readonly"/>
                                <field name="date_request" readonly="can_readonly"/>
                            </group>
                            <group>
                                <field name="priority" widget="priority" readonly="can_readonly"/>
                                <field name="type_id" invisible="1"/>
                                <field name="can_readonly" invisible="1"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" readonly="can_readonly"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="demo_request_view_list" model="ir.ui.view">
            <field name="name">demo.request.list</field>
            <field name="model">demo.request</field>
            <field name="arch" type="xml">
                <list string="Demo Requests" decoration-info="stage_id_color == '2'" decoration-success="stage_id_color == '5'" decoration-danger="stage_id_color == '1'">
                    <field name="reference"/>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="date_request"/>
                    <field name="priority" widget="priority"/>
                    <field name="stage_id"/>
                    <field name="stage_id_color" column_invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="demo_request_view_kanban" model="ir.ui.view">
            <field name="name">demo.request.kanban</field>
            <field name="model">demo.request</field>
            <field name="arch" type="xml">
                <kanban default_group_by="stage_id" class="o_kanban_small_column">
                    <field name="id"/>
                    <field name="reference"/>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="priority"/>
                    <field name="stage_id"/>
                    <field name="stage_id_color"/>
                    <progressbar field="stage_id_color" colors='{"1": "danger", "2": "primary", "3": "muted", "5": "success"}'/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="reference"/>
                                        </strong>
                                    </div>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="name"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="date_request"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Search View -->
        <record id="demo_request_view_search" model="ir.ui.view">
            <field name="name">demo.request.search</field>
            <field name="model">demo.request</field>
            <field name="arch" type="xml">
                <search string="Search Demo Requests">
                    <field name="reference"/>
                    <field name="name"/>
                    <field name="user_id"/>
                    <filter string="My Requests" name="my_requests" domain="[('user_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('stage_id.is_draft', '=', True)]"/>
                    <filter string="Completed" name="completed" domain="[('stage_id.is_done', '=', True)]"/>
                    <separator/>
                    <filter string="High Priority" name="high_priority" domain="[('priority', 'in', ['2', '3'])]"/>
                    <group expand="0" string="Group By">
                        <filter string="Stage" name="group_stage" context="{'group_by': 'stage_id'}"/>
                        <filter string="Requester" name="group_user" context="{'group_by': 'user_id'}"/>
                        <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                        <filter string="Request Date" name="group_date" context="{'group_by': 'date_request'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="demo_request_action" model="ir.actions.act_window">
            <field name="name">Demo Requests</field>
            <field name="res_model">demo.request</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="demo_request_view_search"/>
            <field name="context">{'search_default_my_requests': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Demo Request
                </p>
                <p>
                    This is a demonstration of the Workflow Base module.
                    Create a request and use the workflow buttons to transition between stages.
                </p>
            </field>
        </record>

    </data>
</odoo>
