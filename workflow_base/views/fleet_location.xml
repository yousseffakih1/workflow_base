<odoo>
    <data>
        <record model="ir.ui.view" id="fleet_location_form">
            <field name="name">fleet.location.form</field>
            <field name="model">fleet.location</field>
            <field name="arch" type="xml">
                <form string="Location">

                    <sheet>
                        <group>
                            <field name="name"/>
                             <field name="adresse"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        >
                        </group>
                         <group>
                            <field name="state_id"/>
                            <field name="province_id"/>
                            <field name="collective_id"/>

                        </group>


                    </sheet>

                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="fleet_location_tree">
            <field name="name">fleet.location.tee</field>
            <field name="model">fleet.location</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="state_id"/>
                            <field name="province_id"/>
                            <field name="collective_id"/>

                </list>

            </field>
        </record>

        <record model="ir.actions.act_window" id="fleet_location_action_window">
            <field name="name">Emplacement</field>
            <field name="res_model">fleet.location</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>
</odoo>