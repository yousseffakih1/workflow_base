<odoo>
    <data>
            <record model="ir.ui.view" id="request_stage_route_tree">
            <field name="name">request.stage.route.tree</field>
            <field name="model">request.stage.route</field>
            <field name="arch" type="xml">
                <list>
                      <field name="name" />
                      <field name="description" />
                      <field name="type_id"    />
                     <field name="stage_from_id"    />
                      <field name="stage_to_id"    />
                </list>
            </field>
         </record>
         <record model="ir.ui.view" id="request_stage_route_form">
            <field name="name">request.stage.route.form</field>
            <field name="model">request.stage.route</field>
            <field name="arch" type="xml">
                <form  >
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                                  <field name="description" />
                                <field name="type_id" />
                                <field name="active" widget="boolean_toggle" />


                        </group>
                        <group>
                              <field name="model_id" invisible="1"/>
                              <field name="stage_from_id" domain="[('type_id', '=', type_id)]" context="{'default_type_id': type_id}"/>
                              <field name="stage_to_id" domain="[('type_id', '=', type_id)]" context="{'default_type_id': type_id}"/>
                               <field name="action_id" domain="[('model_id', '=', model_id)]" context="{'default_model_id': model_id}" />
                               
                        </group>
                    </group>
                        <group>
                        <group>
                            <field name="allowed_group_ids" widget="many2many_tags" />
                                  <field name="allowed_user_ids"  widget="many2many_tags"/>


                        </group>
                        <group>

                              <field name="condition_invisible"    widget="code" options="{'mode': 'python'}" />
                               <field name="btn_class"    />
                        </group>

                        </group>


                </sheet>
                </form>
            </field>
         </record>

   <record model="ir.actions.act_window" id="request_stage_route_action_window">
            <field name="name">Rout</field>
            <field name="res_model">request.stage.route</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'group_by': 'type_id'}</field>
        </record>
         <menuitem name="Rout" id="request_stage_route_menu" parent="technique_config_menu" sequence="12"
                  action="request_stage_route_action_window"
        />

    </data>
</odoo>