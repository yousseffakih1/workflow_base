<odoo>
    <data>
 <record model="ir.ui.view" id="mission_form">
            <field name="name">mission.order.form</field>
            <field name="model">mission.order</field>
            <field name="arch" type="xml">
                <form string="Location">
                    <header>

                    <div class="stage_route_out_wrapper">
                        <field name="stage_route_out_json"  widget="stage_route_out_widget"/>
<!--                        widget="stage_route_out_widget"-->
                    </div>
                    <field name="stage_id" widget="statusbar"

                           readonly="1"

                           domain="[('visible', '=', True)]"/>
                </header>
                    <sheet>
                    <group>

                        <field name="stage_id" />
                    </group>

                    </sheet>

                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="missione_action_window">
            <field name="name">Mission</field>
            <field name="res_model">mission.order</field>
            <field name="view_mode">list,form</field>

        </record>

 <menuitem name="Mission" id="mission_menu" parent="technique_config_menu" sequence="12"
                  action="missione_action_window"
        />
    </data>
</odoo>
